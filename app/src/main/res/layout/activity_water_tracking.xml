<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background_light"
    android:fillViewport="true"
    android:padding="20dp">
    <!--аа-->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <!-- Заголовок с иконкой -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:gravity="center"
            android:layout_marginBottom="24dp"
            android:layout_marginTop="8dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="💧"
                android:textSize="56sp"
                android:layout_marginBottom="12dp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Трекер воды"
                android:textColor="@color/text_primary"
                android:textSize="24sp"
                android:textStyle="bold"
                android:letterSpacing="0.02"
                android:layout_marginBottom="4dp" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Следите за своим водным балансом"
                android:textColor="@color/text_secondary"
                android:textSize="14sp"
                android:gravity="center"
                android:lineSpacingExtra="4dp" />

        </LinearLayout>

        <!-- Карточка с прогрессом -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="24dp"
            app:cardCornerRadius="24dp"
            app:cardElevation="8dp"
            app:cardBackgroundColor="@android:color/white">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="28dp">

                <!-- Заголовок прогресса -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:layout_marginBottom="24dp">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="Сегодня"
                        android:textColor="@color/text_primary"
                        android:textSize="18sp"
                        android:textStyle="bold"
                        android:letterSpacing="0.01" />

                    <TextView
                        android:id="@+id/waterProgressText"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="0/2000 мл"
                        android:textColor="@color/primary_color"
                        android:textSize="16sp"
                        android:textStyle="bold"
                        android:background="?attr/selectableItemBackground"
                        android:paddingVertical="8dp"
                        android:paddingHorizontal="12dp"
                        android:clickable="true"
                        android:focusable="true"
                        app:cornerRadius="12dp"
                        app:strokeColor="@color/primary_color"
                        app:strokeWidth="1dp" />

                </LinearLayout>

                <!-- Круговой прогресс -->
                <RelativeLayout
                    android:layout_width="match_parent"
                    android:layout_height="220dp"
                    android:layout_marginBottom="28dp">

                    <!-- Внешний круг (фон) -->
                    <View
                        android:layout_width="180dp"
                        android:layout_height="180dp"
                        android:layout_centerInParent="true"
                        android:background="@drawable/circle_background_water"
                        android:contentDescription="Фон круга прогресса" />

                    <!-- Прогресс (динамический) -->
                    <ImageView
                        android:id="@+id/waterProgressFill"
                        android:layout_width="180dp"
                        android:layout_height="180dp"
                        android:layout_centerInParent="true"
                        android:src="@drawable/circle_progress_water"
                        android:contentDescription="Заполнение прогресса воды" />

                    <!-- Центральный текст с процентом -->
                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_centerInParent="true"
                        android:orientation="vertical"
                        android:gravity="center">

                        <TextView
                            android:id="@+id/waterCenterText"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="0%"
                            android:textColor="@color/primary_color"
                            android:textSize="32sp"
                            android:textStyle="bold"
                            android:letterSpacing="0.02" />

                        <TextView
                            android:id="@+id/progressSubtext"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="цель достигнута"
                            android:textColor="@color/text_secondary"
                            android:textSize="12sp"
                            android:letterSpacing="0.01" />

                    </LinearLayout>

                    <!-- Иконка капли внизу -->
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_centerHorizontal="true"
                        android:layout_alignParentBottom="true"
                        android:text="💧"
                        android:textSize="24sp"
                        android:layout_marginBottom="8dp" />

                </RelativeLayout>

                <!-- Быстрые кнопки добавления воды -->
                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Добавить воду"
                    android:textColor="@color/text_primary"
                    android:textSize="16sp"
                    android:textStyle="bold"
                    android:letterSpacing="0.01"
                    android:layout_marginBottom="16dp" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:layout_marginBottom="24dp">

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/add100mlButton"
                        android:layout_width="0dp"
                        android:layout_height="56dp"
                        android:layout_weight="1"
                        android:layout_marginEnd="8dp"
                        android:text="100 мл"
                        android:textSize="14sp"
                        android:textStyle="bold"
                        app:cornerRadius="16dp"
                        app:backgroundTint="#E3F2FD"
                        app:icon="@drawable/ic_water_small"
                        app:iconTint="@color/primary_color"
                        app:iconSize="20dp"
                        app:iconPadding="8dp"
                        android:textColor="@color/primary_color"
                        style="?attr/materialButtonOutlinedStyle" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/add250mlButton"
                        android:layout_width="0dp"
                        android:layout_height="56dp"
                        android:layout_weight="1"
                        android:layout_marginEnd="8dp"
                        android:text="250 мл"
                        android:textSize="14sp"
                        android:textStyle="bold"
                        app:cornerRadius="16dp"
                        app:backgroundTint="#E8F5E9"
                        app:icon="@drawable/ic_water_medium"
                        app:iconTint="@color/success_color"
                        app:iconSize="22dp"
                        app:iconPadding="8dp"
                        android:textColor="@color/success_color"
                        style="?attr/materialButtonOutlinedStyle" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/add500mlButton"
                        android:layout_width="0dp"
                        android:layout_height="56dp"
                        android:layout_weight="1"
                        android:text="500 мл"
                        android:textSize="14sp"
                        android:textStyle="bold"
                        app:cornerRadius="16dp"
                        app:backgroundTint="#FFF3E0"
                        app:icon="@drawable/ic_water_large"
                        app:iconTint="@color/warning_color"
                        app:iconSize="24dp"
                        app:iconPadding="8dp"
                        android:textColor="@color/warning_color"
                        style="?attr/materialButtonOutlinedStyle" />

                </LinearLayout>

                <!-- Пользовательский ввод -->
                <com.google.android.material.button.MaterialButton
                    android:id="@+id/customAmountButton"
                    android:layout_width="match_parent"
                    android:layout_height="56dp"
                    android:text="Добавить другое количество"
                    android:textSize="15sp"
                    android:textStyle="bold"
                    android:letterSpacing="0.01"
                    app:cornerRadius="16dp"
                    app:backgroundTint="@color/primary_color"
                    app:icon="@drawable/ic_add_custom"
                    app:iconTint="@android:color/white"
                    app:iconSize="20dp"
                    app:iconPadding="8dp"
                    app:elevation="2dp"
                    style="?attr/materialButtonOutlinedStyle" />

            </LinearLayout>

        </com.google.android.material.card.MaterialCardView>

        <!-- История приема воды -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="24dp"
            app:cardCornerRadius="24dp"
            app:cardElevation="8dp"
            app:cardBackgroundColor="@android:color/white">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="28dp">

                <!-- Заголовок истории -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:layout_marginBottom="20dp">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="📊 История приема воды"
                        android:textColor="@color/text_primary"
                        android:textSize="18sp"
                        android:textStyle="bold"
                        android:letterSpacing="0.01" />

                    <TextView
                        android:id="@+id/todayDateText"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Сегодня"
                        android:textColor="@color/text_secondary"
                        android:textSize="14sp"
                        android:paddingVertical="6dp"
                        android:paddingHorizontal="12dp"
                        android:background="@drawable/rounded_bg_secondary"
                        app:cornerRadius="12dp" />

                </LinearLayout>

                <!-- Контейнер для истории -->
                <LinearLayout
                    android:id="@+id/waterHistoryLayout"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:visibility="gone" />

                <!-- Пустое состояние -->
                <LinearLayout
                    android:id="@+id/emptyHistory"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:gravity="center"
                    android:padding="32dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="💧"
                        android:textSize="48sp"
                        android:layout_marginBottom="16dp" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Вы еще не пили воду сегодня"
                        android:textColor="@color/text_primary"
                        android:textSize="16sp"
                        android:textStyle="bold"
                        android:gravity="center"
                        android:layout_marginBottom="8dp"
                        android:letterSpacing="0.01" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Добавьте первый прием воды, нажав на кнопки выше"
                        android:textColor="@color/text_secondary"
                        android:textSize="14sp"
                        android:gravity="center"
                        android:lineSpacingExtra="4dp" />

                </LinearLayout>

            </LinearLayout>

        </com.google.android.material.card.MaterialCardView>

        <!-- Статистика за неделю -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:cardCornerRadius="24dp"
            app:cardElevation="8dp"
            app:cardBackgroundColor="@android:color/white">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="28dp">

                <!-- Заголовок статистики -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:layout_marginBottom="20dp">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="📈 Статистика за неделю"
                        android:textColor="@color/text_primary"
                        android:textSize="18sp"
                        android:textStyle="bold"
                        android:letterSpacing="0.01" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="7 дней"
                        android:textColor="@color/text_secondary"
                        android:textSize="14sp"
                        android:paddingVertical="6dp"
                        android:paddingHorizontal="12dp"
                        android:background="@drawable/rounded_bg_secondary"
                        app:cornerRadius="12dp" />

                </LinearLayout>

                <!-- График статистики -->
                <LinearLayout
                    android:id="@+id/weeklyChartContainer"
                    android:layout_width="match_parent"
                    android:layout_height="180dp"
                    android:layout_marginBottom="20dp"
                    android:background="@drawable/chart_background"
                    android:gravity="center">

                    <TextView
                        android:id="@+id/chartPlaceholder"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="📊 График загрузки..."
                        android:textColor="@color/text_secondary"
                        android:textSize="14sp" />

                    <!-- Здесь будет программно добавлен график -->
                </LinearLayout>

                <!-- Текстовая статистика -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:layout_marginBottom="16dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:layout_marginBottom="12dp">

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="Среднее за день:"
                            android:textColor="@color/text_primary"
                            android:textSize="14sp" />

                        <TextView
                            android:id="@+id/averageDailyText"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="0 мл"
                            android:textColor="@color/primary_color"
                            android:textSize="14sp"
                            android:textStyle="bold" />

                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal">

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="Дней с нормой:"
                            android:textColor="@color/text_primary"
                            android:textSize="14sp" />

                        <TextView
                            android:id="@+id/daysWithGoalText"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="0 из 7"
                            android:textColor="@color/success_color"
                            android:textSize="14sp"
                            android:textStyle="bold" />

                    </LinearLayout>

                </LinearLayout>

                <!-- Прогресс недели -->
                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Прогресс недели"
                    android:textColor="@color/text_secondary"
                    android:textSize="12sp"
                    android:layout_marginBottom="8dp"
                    android:letterSpacing="0.01" />

                <com.google.android.material.progressindicator.LinearProgressIndicator
                    android:id="@+id/weeklyProgressBar"
                    android:layout_width="match_parent"
                    android:layout_height="8dp"
                    android:layout_marginBottom="4dp"
                    app:trackColor="@color/background_light"
                    app:trackCornerRadius="4dp"
                    app:indicatorColor="@color/primary_color" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="0%"
                        android:textColor="@color/text_secondary"
                        android:textSize="12sp" />

                    <TextView
                        android:id="@+id/weeklyProgressText"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="0/7 дней"
                        android:textColor="@color/primary_color"
                        android:textSize="12sp"
                        android:textStyle="bold" />

                </LinearLayout>

            </LinearLayout>

        </com.google.android.material.card.MaterialCardView>

        <!-- Футер -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Рекомендуемая норма: 30-35 мл на 1 кг веса"
            android:textColor="@color/text_secondary"
            android:textSize="12sp"
            android:gravity="center"
            android:padding="16dp"
            android:letterSpacing="0.01"
            android:lineSpacingExtra="2dp" />

    </LinearLayout>

</ScrollView>